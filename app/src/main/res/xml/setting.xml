<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="@string/theme_setting">
        <ListPreference
                app:key="app_theme"
                app:title="@string/theme_setting"
                app:summary="%s"
                app:entries="@array/theme_entries"
                app:entryValues="@array/theme_values"
                app:defaultValue="system" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/dns_setting">
        <ListPreference
                app:key="dns_mode"
                app:title="@string/dns_mode"
                app:summary="%s"
                app:entries="@array/dns_mode_entries"
                app:entryValues="@array/dns_mode_values"
                app:defaultValue="system" />

        <EditTextPreference
                app:key="dns_custom_ip"
                app:title="@string/dns_custom_ip"
                app:summary="@string/dns_custom_ip_summary"
                app:dialogTitle="@string/dns_custom_ip"
                app:dependency="dns_mode" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Snapshot Backup &amp; Restore">
        <Preference
                android:key="snapshot_backup"
                android:title="@string/snapshot_backup"
                android:summary="@string/snapshot_backup_summary" />

        <Preference
                android:key="snapshot_restore"
                android:title="@string/snapshot_restore"
                android:summary="@string/snapshot_restore_summary" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/other">
        <Preference
                android:key="gms_manager"
                android:title="@string/gms_manager"
                android:summary="@string/jump_gms"/>

        <SwitchPreferenceCompat
                app:key="root_hide"
                app:title="@string/hide_root" />

        <SwitchPreferenceCompat
                app:key="daemon_enable"
                app:title="@string/daemon_enable" />

        <SwitchPreferenceCompat
                app:key="disable_flag_secure"
                app:title="@string/disable_flag_secure"
                app:summary="@string/disable_flag_secure_summary" />

        <Preference
                android:key="send_logs"
                android:title="Send Logs"
                android:summary="Upload debug logs to developer" />
    </PreferenceCategory>

</PreferenceScreen>
